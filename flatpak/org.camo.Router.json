{
    "app-id": "org.camo.Router",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.6",
    "sdk": "org.kde.Sdk",
    "command": "camo-launcher",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=x11",
        "--device=all",
        "--filesystem=xdg-run/pipewire-0"
    ],
    "modules": [
        {
            "name": "python3-pyside6",
            "buildsystem": "simple",
            "build-options": {
                "build-args": [
                    "--share=network"
                ]
            },
            "build-commands": [
                "pip3 install --prefix=/app PySide6"
            ]
        },
        {
            "name": "camo",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/camo",
                "cp -r camo_app /app/share/camo/",
                "install -D -m 755 flatpak/camo-launcher /app/bin/camo-launcher",
                "install -D -m 644 flatpak/org.camo.Router.desktop /app/share/applications/org.camo.Router.desktop",
                "install -D -m 644 flatpak/org.camo.Router.metainfo.xml /app/share/metainfo/org.camo.Router.metainfo.xml",
                "mkdir -p /app/share/icons/hicolor/512x512/apps",
                "cp camo_app/assets/logo.png /app/share/icons/hicolor/512x512/apps/org.camo.Router.png || true"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
